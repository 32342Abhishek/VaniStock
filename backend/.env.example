# ============================================================
# VaaniStock Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=vaanistock

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Provider (google | openai | rule_based)
# Set to "rule_based" to use the deterministic parser (no API key needed)
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Speech-to-Text Provider (browser | cloud)
STT_PROVIDER=browser
STT_API_KEY=
STT_MODEL=

# Text-to-Speech Provider (browser | cloud)
TTS_PROVIDER=browser

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
APP_ENV=development
APP_PORT=8000
